	(gr_text "Our Smuckie, who\nart in Rogers,\nhallowed by thy name.\nThy exam grades come,\nthy regrades be done,\non canvas as they\nare in gradescope.\nGive us this our daily\nlecture, and forgive\nour mistakes as we\nforgive your smuckie\n\nmoments.\nLead us not\ninto ignorance but\ndeliver our GPAs from\nevil. For yours is\nthe power and the\n\nglory forever. ABen\n"
		(at 226.22 88.51 0)
		(layer "B.SilkS")
		(uuid "e80513c5-197d-4c3d-ba32-942fd34ca3ea")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.1)
			)
			(justify left bottom mirror)
		)
	)
